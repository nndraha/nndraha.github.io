library(bib2df)
library(stringr)
library(dplyr)
# 1. Set your file paths (adjust if your working directory is inside /content)
bib_path <- "./publications/cite.bib"
out_dir  <- "./publications"
# 2. Fix the "incomplete final line" warning automatically
raw_lines <- readLines(bib_path, warn = FALSE, encoding = "UTF-8")
writeLines(raw_lines, bib_path, useBytes = TRUE)
# 3. Read the BibTeX data
bib_data <- bib2df(bib_path)
for (i in seq_len(nrow(bib_data))) {
row <- bib_data[i, ]
# Create a clean folder slug from the BibTeX key (e.g., "ndraha2025mra")
slug <- str_replace_all(tolower(row$BIBTEXKEY), "[^a-z0-9-]", "-")
pub_dir <- file.path(out_dir, slug)
dir.create(pub_dir, recursive = TRUE, showWarnings = FALSE)
# Map BibTeX CATEGORY to HugoBlox CSL publication_types
cat_type <- toupper(row$CATEGORY)
pub_type <- case_when(
cat_type == "ARTICLE"       ~ "article-journal",
cat_type == "INCOLLECTION"  ~ "chapter",
cat_type == "INPROCEEDINGS" ~ "paper-conference",
TRUE                        ~ "article"
)
# Clean authors: convert "Last, First" -> "First Last" and map your name to "nodali"
authors <- unlist(row$AUTHOR)
authors_clean <- sapply(authors, function(a) {
if (str_detect(a, regex("Ndraha", ignore_case = TRUE))) {
return("nodali")
}
# Flip "Last, First" to "First Last" if a comma is present
if (str_detect(a, ",")) {
parts <- str_trim(str_split(a, ",")[[1]])
if (length(parts) >= 2) return(paste(parts[2], parts[1]))
}
return(str_trim(a))
}, USE.NAMES = FALSE)
# Map your BibTeX "selected = {true}" directly to HugoBlox "featured: true"
is_featured <- "false"
if ("SELECTED" %in% names(row) && !is.na(row$SELECTED)) {
if (tolower(as.character(row$SELECTED)) == "true") is_featured <- "true"
}
# Format Title (convert <em> tags to Markdown *italics* and strip curly braces)
clean_title <- row$TITLE %>%
str_replace_all("</?em>", "*") %>%
str_replace_all("[{}]", "") %>%
str_replace_all("\"", "'")
# Format Venue (Journal or Booktitle)
venue <- ifelse(!is.na(row$JOURNAL), row$JOURNAL,
ifelse(!is.na(row$BOOKTITLE), row$BOOKTITLE, ""))
venue <- str_replace_all(venue, "[{}]", "")
# Format Date (use January 1st of the publication year)
yr <- ifelse(!is.na(row$YEAR), as.character(row$YEAR), "2026")
pub_date <- paste0(yr, "-01-01")
# Format Abstract (clean special spaces and quotes)
abstr <- ""
if ("ABSTRACT" %in% names(row) && !is.na(row$ABSTRACT)) {
abstr <- row$ABSTRACT %>%
str_replace_all("</?em>", "*") %>%
str_replace_all("[\"{}]", "") %>%
str_replace_all("[\\u00A0\\u202F]", " ") # Replace non-breaking spaces
}
# Optional URL fallback if HTML field is present in your bib
url_source <- ""
if ("HTML" %in% names(row) && !is.na(row$HTML)) {
url_source <- row$HTML
}
# Construct YAML frontmatter for index.md
md_content <- paste0(
"---\n",
"title: \"", clean_title, "\"\n",
"date: \"", pub_date, "\"\n",
"authors:\n", paste0("  - \"", authors_clean, "\"", collapse = "\n"), "\n",
"publication_types: [\"", pub_type, "\"]\n",
"publication: \"*", venue, "*\"\n",
"doi: \"", ifelse(!is.na(row$DOI), row$DOI, ""), "\"\n",
"abstract: \"", abstr, "\"\n",
"featured: ", is_featured, "\n",
if (url_source != "") paste0("links:\n  - type: source\n    url: \"", url_source, "\"\n") else "",
"---\n"
)
# Write index.md in UTF-8
writeLines(md_content, file.path(pub_dir, "index.md"), useBytes = TRUE)
# Write a clean individual cite.bib for the "Cite" button on each paper's page
# (Keep only standard BibTeX columns so HugoBlox's citation modal stays tidy)
std_cols <- intersect(names(row), c("CATEGORY", "BIBTEXKEY", "AUTHOR", "TITLE",
"JOURNAL", "BOOKTITLE", "YEAR", "VOLUME",
"NUMBER", "PAGES", "DOI", "ISSN", "PUBLISHER"))
df2bib(row[, std_cols], file = file.path(pub_dir, "cite.bib"))
}
message("Successfully generated ", nrow(bib_data), " publication folders!")
