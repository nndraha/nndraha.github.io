# 1. Set paths (update bib_path to wherever you uploaded your cite.bib)
bib_path <- "./publications/cite.bib"
# Install packages if needed: install.packages(c("bib2df", "stringr"))
library(bib2df)
library(stringr)
# 1. Set paths (update bib_path to wherever you uploaded your cite.bib)
